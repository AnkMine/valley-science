# AI Configuration
# AI_PROVIDER: local | openrouter | gemini | auto
# Copy this file to backend/.env and fill in values. Without .env, chat has no AI keys.
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=phi-4-mini-instruct
LOCAL_LLM_API_KEY=lm-studio
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# GEMINI_MODEL=gemini-2.5-flash

# Email Configuration (SMTP)
# Gmail requires a Google App Password (not your normal password). See docs/email-setup.md
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
# Optional overrides (usually leave blank when SMTP_SERVICE=gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Where demo-request / inquiry notifications are sent (defaults to SMTP_USER)
ADMIN_EMAIL=

# Public URL for approve links in emails (use your LAN IP when testing on other devices)
APP_BASE_URL=http://localhost:3000

# Firebase Admin (path to service account JSON, or leave blank to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Server
PORT=3001
NODE_ENV=development

# Cron job auth — required for /api/cron/* endpoints
CRON_SECRET=

# Firestore backups (gcloud export — see backend/scripts/export-firestore.sh)
# GCS bucket URI, e.g. gs://valley-science-firestore-backups
GCS_BACKUP_BUCKET=
# Optional overrides (defaults from firebase-applet-config.json)
# GCP_PROJECT_ID=
# FIRESTORE_DATABASE_ID=
