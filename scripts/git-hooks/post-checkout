#!/usr/bin/env bash
# Installed into .git/hooks/post-checkout by: npm run prepare
# After a branch switch, make sure frontend and backend deps match the
# new branch. No-op (under a second) when they already match.

branch_checkout="${3:-}"

# File checkout (not a branch switch) — skip.
if [[ "$branch_checkout" != "1" ]]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0

bash "$root/scripts/setup-dev.sh" || echo "⚠ deps setup failed — run: npm run setup"
